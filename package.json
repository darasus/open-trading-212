{
  "name": "open-trading-212",
  "version": "0.1.2",
  "description": "Privacy-first portfolio cockpit for Trading 212 with a local AI analyst. No server: keys in your OS keychain, data in local SQLite.",
  "main": "./out/main/index.js",
  "author": "Ilia Daraselia",
  "homepage": "https://github.com/darasus/open-trading-212",
  "scripts": {
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "lint": "oxlint",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "bun run typecheck:node && bun run typecheck:web",
    "test": "vitest run",
    "test:watch": "vitest",
    "start": "install-electron && electron-vite preview",
    "dev": "install-electron && electron-vite dev --watch",
    "build": "bun run typecheck && electron-vite build",
    "build:unpack": "bun run build && electron-builder --dir",
    "build:win": "bun run build && electron-builder --win",
    "build:mac": "bun run build && electron-builder --mac",
    "db:generate": "drizzle-kit generate",
    "db:studio": "drizzle-kit studio",
    "screenshots": "electron-vite build && node scripts/screenshots.mjs"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.82",
    "@ai-sdk/google": "^4",
    "@ai-sdk/openai": "^4",
    "@ai-sdk/openai-compatible": "^3",
    "@electron-toolkit/utils": "^4.0.0",
    "ai": "^7.0.143",
    "better-sqlite3": "^13.0.3",
    "drizzle-orm": "^0.45.4",
    "electron-updater": "^6.8.9",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@ai-sdk/react": "^4.0.147",
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@radix-ui/react-use-controllable-state": "^1.3.0",
    "@streamdown/cjk": "^1.0.4",
    "@streamdown/code": "^1.1.1",
    "@streamdown/math": "^1.0.3",
    "@streamdown/mermaid": "^1.0.3",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query": "^5.104.4",
    "@tanstack/react-router": "^1.170.45",
    "@testing-library/react": "^16.3.3",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.19.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.1.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "cn": "^0.5.0",
    "drizzle-kit": "^0.31.11",
    "electron": "^45.0.0",
    "electron-builder": "^26.0.12",
    "electron-vite": "^6.0.0",
    "happy-dom": "^20.14.5",
    "lucide-react": "^1.59.0",
    "motion": "^13.2.0",
    "nanoid": "^6.0.2",
    "oxfmt": "^0.73.0",
    "oxlint": "^1.88.0",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "recharts": "^3.10.1",
    "shiki": "^4.5.0",
    "streamdown": "^2.7.0",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3",
    "use-stick-to-bottom": "^1.1.6",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/darasus/open-trading-212.git"
  },
  "trustedDependencies": [
    "esbuild"
  ]
}
